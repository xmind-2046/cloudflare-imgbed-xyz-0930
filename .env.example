# CloudFlare ImgBed - Workers deploy config (template)
# 复制为 .env 后填写：cp .env.example .env
# .env 已在 .gitignore 中，绝不会入库。

# ---- 认证（二选一）----
# 方式 A：API Token（推荐，CI 与本机通用）
#   在 https://dash.cloudflare.com/profile/api-tokens 创建，
#   模板选 "Edit Cloudflare Workers"，账户资源限定到目标账户。
CLOUDFLARE_API_TOKEN=
# 方式 B：留空 CLOUDFLARE_API_TOKEN，先执行一次 `npx wrangler login` 走浏览器授权。

# Cloudflare 账户 ID：Dashboard 右侧 Account ID，或 `npx wrangler whoami` 查看
CLOUDFLARE_ACCOUNT_ID=

# Worker 名称，将作为 *.workers.dev 子域名前缀
WORKER_NAME=cloudflare-imgbed-xyz-0930

# ---- 存储：D1 与 KV 二选一，留空表示不启用 ----
D1_DATABASE_ID=
KV_NAMESPACE_ID=

# R2 桶，绑定为 img_r2
R2_BUCKET_NAME=img-r2

# 业务环境变量，JSON 字符串，例如：{"BASIC_AUTH":"cfbed"}
WORKER_VARS=

# 账户未订阅 Cloudflare Images 时设为 1，剥离 [images] 绑定
SKIP_IMAGES=1

# ---- 可观测性 ----
# OBSERVABILITY=0 关闭；OBSERVABILITY_PERSIST=0 关闭日志持久化（持久化需 Workers 付费计划）
# head_sampling_rate 默认 1（100% 采样）。公开图床流量大时建议改 0.1，避免日志量/成本失控
OBSERVABILITY_LOGS_SAMPLING=1
